# Database
DATABASE_URL=postgresql+psycopg://sportscards:sportscards@localhost:5433/sportscards

# eBay Browse API (OAuth2 client-credentials)
# Get at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION   # or SANDBOX

# PSA Public API
# Free tier: 100 calls/day. Token at https://www.psacard.com/publicapi
PSA_TOKEN=

# DeepSeek V4 Flash (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Prefect (defaults are fine for local)
PREFECT_API_URL=http://localhost:4200/api
